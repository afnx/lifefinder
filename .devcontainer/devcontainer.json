{
    "name": "LifeFinder Dev",
    "dockerComposeFile": [
        "compose.yaml"
    ],
    "service": "lifefinder",
    "workspaceFolder": "/app",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-azuretools.vscode-docker",
                "njpwerner.autodocstring",
                "streetsidesoftware.code-spell-checker",
                "ms-toolsai.jupyter",
                "charliermarsh.ruff"
            ],
            "settings": {
                "python.pythonPath": "/usr/local/bin/python3",
                "jupyter.jupyterServerURI": "http://localhost:8888"
            }
        }
    },
    "forwardPorts": [
        8501,
        8888
    ]
}