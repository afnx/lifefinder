# LifeFinder Configuration
VERSION=0.0.1

# NASA API
NASA_API_KEY=YOUR_NASA_API_KEY_HERE
NASA_TAP_SYNC=https://exoplanetarchive.ipac.caltech.edu/TAP/sync
NASA_API_LIMIT=1000
FORCE_NASA_API_FETCH=False

# Paths
LIFEFINDER_DATA=
LIFEFINDER_RAW=
LIFEFINDER_PROCESSED=
LIFEFINDER_CACHE=
LIFEFINDER_MODELS=

# Training hyperparameters
BATCH_SIZE=32
EPOCHS=10
LEARNING_RATE=1e-3
HIDDEN_DIM=64
DROPOUT=0.3
VAL_SPLIT=0.2
RANDOM_STATE=42

# Astronomical constants
HABITABLE_ZONE_SIGMA=100.0
HABITABLE_ZONE_THRESHOLD=0.5