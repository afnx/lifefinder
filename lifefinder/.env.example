# NASA API
NASA_TAP_SYNC=https://exoplanetarchive.ipac.caltech.edu/TAP/sync
NASA_API_LIMIT=1000
FORCE_NASA_API_FETCH=False

# Artifact directory
# Directory for storing artifacts like models, data, and logs
ARTIFACTS_DIR=~/.lifefinder/artifacts

# Training hyperparameters
BATCH_SIZE=32
EPOCHS=10
LEARNING_RATE=1e-3
HIDDEN_DIM=64
DROPOUT=0.3
VAL_SPLIT=0.2
RANDOM_STATE=42
PATIENCE=5

# Astronomical constants
HABITABLE_ZONE_SIGMA=1.0
HABITABLE_ZONE_THRESHOLD=0.5

# Model target feature
TARGET_FEATURE=habitable_zone_index
